# Public alpha template. Supply secrets privately on the chosen host.
# Blank required values intentionally prevent accidental production startup.
RUNTIME_PROFILE=hosted
ENVIRONMENT=production
DEBUG=false
AUTH_REQUIRED=true
PASSWORD_AUTH_ENABLED=false
SOCIAL_SIGNUP_ROLE=analyst
ALLOW_SELF_SIGNUP=false
ENABLE_DEFAULT_VIEWER=false
DATABASE_URL=
ALLOWED_ORIGINS=
NEON_AUTH_URL=
NEON_JWKS_URL=
# On Render, leave this empty to use the validated RENDER_EXTERNAL_URL origin.
STATIC_FRONTEND_DIR=/app/web
JWT_SECRET_KEY=
GITHUB_WEBHOOK_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_JOBS_PER_DAY=30
REPO_SOURCE_MAX_FILES=500
REPO_SOURCE_MAX_TOTAL_BYTES=8388608
OPENAI_API_KEY=
GITHUB_TOKEN=
