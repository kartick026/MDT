ADMIN_PASSWORD=
JWT_SECRET_KEY=
GITHUB_WEBHOOK_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_JOBS_PER_DAY=30
REPO_SOURCE_MAX_FILES=500
REPO_SOURCE_MAX_TOTAL_BYTES=8388608
OPENAI_API_KEY=
GITHUB_TOKEN=
