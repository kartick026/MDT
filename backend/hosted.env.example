# Public alpha template. Supply secrets privately on the chosen host.
# Blank required values intentionally prevent accidental production startup.
RUNTIME_PROFILE=hosted
ENVIRONMENT=production
DEBUG=false
AUTH_REQUIRED=true
ALLOW_SELF_SIGNUP=false
ENABLE_DEFAULT_VIEWER=false
DATABASE_URL=
ALLOWED_ORIGINS=
