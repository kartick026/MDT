# Microservice Drift Tracker - Backend Environment
# Copy this to backend/.env and update values

# Application
APP_NAME="Microservice Drift Tracker"
DEBUG=true

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ChromaDB
CHROMADB_HOST=chroma

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub Personal Access Token (for fetching diffs via API — no clone needed)
# Scopes needed: repo (for private repos) or public_repo (for public repos)
# Leave empty for public repos without rate-limit concerns
GITHUB_TOKEN=your_github_pat_here

# GitHub App Authentication (optional — higher rate limits, enterprise auth)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# AI / LLM provider
# --- Option A: OpenAI (default) ---
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
# --- Option B: Google Gemini (uncomment and replace) ---
# OPENAI_API_KEY=your_google_api_key_here
# LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Microservices
USER_SERVICE_URL=http://user-service:8001
ORDER_SERVICE_URL=http://order-service:8002
PAYMENT_SERVICE_URL=http://payment-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004

# Architectural-smell thresholds
SMELL_BOTTLENECK_INBOUND_THRESHOLD=3
SMELL_BOTTLENECK_TOTAL_DEGREE_THRESHOLD=5
SMELL_HIGH_COUPLING_THRESHOLD=3
SMELL_DEPENDENCY_GROWTH_THRESHOLD=3
SMELL_API_CHURN_THRESHOLD=3
