FROM python:3.11-alpine3.24 AS dependencies
WORKDIR /build
# Compile any parser wheels here; compilers never enter the serving image.
RUN apk add --no-cache build-base
COPY requirements-hosted.txt ./
RUN pip wheel --no-cache-dir --wheel-dir=/wheels -r requirements-hosted.txt

FROM python:3.11-alpine3.24
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000
RUN apk upgrade --no-cache && apk add --no-cache git ca-certificates libstdc++
COPY requirements-hosted.txt ./
RUN --mount=type=bind,from=dependencies,source=/wheels,target=/wheels \
    pip install --no-cache-dir --no-index --find-links=/wheels -r requirements-hosted.txt \
    && pip uninstall -y pip setuptools wheel
RUN addgroup -g 10001 mdt && adduser -D -u 10001 -G mdt mdt
COPY --chown=mdt:mdt . .
USER mdt
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
